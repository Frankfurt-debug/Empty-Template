# Copy to .env (dotenv is already a dependency) or set these on your host.

# Port to listen on. Most hosts set this for you.
PORT=8080

# Password protection (same as setting `challenge: true` in config.js).
# Logins are defined in config.js; PASSWORD overrides the default user's password.
CHALLENGE=false
PASSWORD=password

# Secret used to sign session tokens. Set this so logins survive restarts
# (otherwise a random secret is generated at boot).
SESSION_SECRET=

# Which page origins may open the control WebSocket (/ws). "*" allows all.
# Use "null" for HTML files opened from disk (file://) and about:blank windows.
# Example: ALLOWED_ORIGINS=https://my-user.github.io,null
ALLOWED_ORIGINS=*
